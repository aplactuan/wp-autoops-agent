{
	"info": {
		"_postman_id": "wp-autoops-agent-collection",
		"name": "WP AutoOps Agent",
		"description": "REST API collection for WP AutoOps Agent.\n\nAuth: WordPress Application Passwords (Basic Auth) or cookie/nonce.\nRequires an administrator account (manage_options).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://test.local"
		},
		{
			"key": "wpUsername",
			"value": "admin"
		},
		{
			"key": "wpAppPassword",
			"value": "xxxx xxxx xxxx xxxx xxxx xxxx"
		}
	],
	"auth": {
		"type": "basic",
		"basic": [
			{
				"key": "username",
				"value": "{{wpUsername}}",
				"type": "string"
			},
			{
				"key": "password",
				"value": "{{wpAppPassword}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "Health",
			"item": [
				{
					"name": "GET Ping",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/wp-json/wp-autoops/v1/ping",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"wp-json",
								"wp-autoops",
								"v1",
								"ping"
							]
						},
						"description": "Health check. Returns plugin, WordPress, and PHP versions plus a UTC timestamp."
					},
					"response": []
				},
				{
					"name": "GET Status",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/wp-json/wp-autoops/v1/status",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"wp-json",
								"wp-autoops",
								"v1",
								"status"
							]
						},
						"description": "Aggregated site status from providers: site, wordpress, php, theme, plugins."
					},
					"response": []
				}
			]
		},
		{
			"name": "Actions",
			"item": [
				{
					"name": "POST Action - ping",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"actions\": [\n    {\n      \"type\": \"ping\"\n    }\n  ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/wp-json/wp-autoops/v1/actions",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"wp-json",
								"wp-autoops",
								"v1",
								"actions"
							]
						},
						"description": "Action type: ping\n\nVerifies the action framework is operational."
					},
					"response": []
				},
				{
					"name": "POST Action - update_plugins",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"actions\": [\n    {\n      \"type\": \"update_plugins\",\n      \"plugins\": [\n        {\n          \"basename\": \"elementor/elementor.php\"\n        },\n        {\n          \"basename\": \"woocommerce/woocommerce.php\"\n        }\n      ]\n    }\n  ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/wp-json/wp-autoops/v1/actions",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"wp-json",
								"wp-autoops",
								"v1",
								"actions"
							]
						},
						"description": "Action type: update_plugins\n\nUpdates each listed plugin individually via Plugin_Upgrader.\nContinues on individual failures and returns per-plugin results."
					},
					"response": []
				},
				{
					"name": "POST Action - update_theme",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"actions\": [\n    {\n      \"type\": \"update_theme\"\n    }\n  ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/wp-json/wp-autoops/v1/actions",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"wp-json",
								"wp-autoops",
								"v1",
								"actions"
							]
						},
						"description": "Action type: update_theme\n\nUpdates every installed theme that has an available update via Theme_Upgrader.\nContinues on individual failures and returns per-theme results."
					},
					"response": []
				},
				{
					"name": "POST Action - update_core",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"actions\": [\n    {\n      \"type\": \"update_core\"\n    }\n  ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/wp-json/wp-autoops/v1/actions",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"wp-json",
								"wp-autoops",
								"v1",
								"actions"
							]
						},
						"description": "Action type: update_core\n\nUpdates WordPress Core when an update is available. Idempotent if already up to date."
					},
					"response": []
				},
				{
					"name": "POST Action - backup",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"actions\": [\n    {\n      \"type\": \"backup\"\n    }\n  ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/wp-json/wp-autoops/v1/actions",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"wp-json",
								"wp-autoops",
								"v1",
								"actions"
							]
						},
						"description": "Action type: backup\n\nQueues a full UpdraftPlus backup (files + database).\nRequires UpdraftPlus to be installed and active."
					},
					"response": []
				},
				{
					"name": "POST Action - backup (optional options)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"actions\": [\n    {\n      \"type\": \"backup\",\n      \"nocloud\": true,\n      \"label\": \"AutoOps pre-maintenance backup\"\n    }\n  ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/wp-json/wp-autoops/v1/actions",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"wp-json",
								"wp-autoops",
								"v1",
								"actions"
							]
						},
						"description": "Action type: backup with optional fields.\n\n- nocloud: skip remote storage upload\n- label: UpdraftPlus backup label"
					},
					"response": []
				},
				{
					"name": "POST Actions - batch example",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"actions\": [\n    {\n      \"type\": \"ping\"\n    },\n    {\n      \"type\": \"backup\",\n      \"label\": \"Batch run backup\"\n    },\n    {\n      \"type\": \"update_plugins\",\n      \"plugins\": [\n        {\n          \"basename\": \"akismet/akismet.php\"\n        }\n      ]\n    }\n  ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/wp-json/wp-autoops/v1/actions",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"wp-json",
								"wp-autoops",
								"v1",
								"actions"
							]
						},
						"description": "Multiple actions in one request. Unknown action types abort the batch."
					},
					"response": []
				}
			]
		}
	]
}
